# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kss_platform_dev
DB_USER=change_me
DB_PASSWORD=change_me

# --- Auth secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_random_64_hex_chars
# Used later for encrypting FMH API keys per client (not used yet in this demo build)
ENCRYPTION_KEY=change_me_random_64_hex_chars

# --- App ---
PORT=3000
NODE_ENV=production

# --- Internal cron secret (for /internal/run-daily-reports, added later) ---
INTERNAL_CRON_SECRET=change_me
